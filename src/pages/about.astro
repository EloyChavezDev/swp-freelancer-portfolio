---
import PageLayout from '~/layouts/PageLayout.astro';
import About from '~/components/home/About.astro';
import Toolkit from '~/components/home/Toolkit.astro';
import Process from '~/components/home/Process.astro';
import Awards from '~/components/home/Awards.astro';
import Testimonials from '~/components/home/Testimonials.astro';
import StatsBand from '~/components/home/StatsBand.astro';
import Cta from '~/components/home/Cta.astro';
import siteConfig from '~/config/site';
import { graph, personSchema, breadcrumbSchema } from '~/lib/jsonld';

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: 'Inicio', url: `${siteConfig.url}/` },
    { name: 'Acerca de', url: `${siteConfig.url}/about/` },
  ]),
]);
---

<PageLayout
  title="Acerca de"
  heading="Finanzas claras para tomar mejores decisiones."
  eyebrow="Acerca de"
  intro="Te ayudo a poner en orden tus finanzas personales mediante asesorías personalizadas y talleres, con estrategias creadas según tu estilo de vida."
  description={`Acerca de ${siteConfig.author} — consultor financiero que te ayuda a poner en orden tus finanzas personales.`}
  crumbs={[{ label: 'Acerca de' }]}
  jsonLd={jsonLd}
>
  <About headingLevel="h2" id="background" />
  <StatsBand />
  <Toolkit />
  <Process />
  <Awards />
  <Testimonials />
  <Cta />
</PageLayout>
