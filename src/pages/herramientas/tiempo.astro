---
import BaseLayout from '~/layouts/BaseLayout.astro';
import siteConfig from '~/config/site';
import { graph, personSchema, breadcrumbSchema } from '~/lib/jsonld';

const breadcrumbs = [
  { name: 'Inicio', url: `${siteConfig.url}/` },
  { name: 'Herramientas', url: `${siteConfig.url}/herramientas/` },
  { name: 'Tiempo', url: `${siteConfig.url}/herramientas/tiempo/` },
];
const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema(breadcrumbs),
]);
---

<BaseLayout
  title="TimeWorth - ¿Cuánto tiempo de tu vida cuesta?"
  description="Calcula el costo real de tus compras en horas de trabajo y evalúa tu presupuesto con la regla 50/30/20."
  jsonLd={jsonLd}
>

  <!-- Tailwind config (antes del CDN para que apliquen brand/needs/wants/savings) -->
  <script>
    // @ts-nocheck
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            display: ['Outfit', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#eef2ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
            },
            needs: '#3b82f6',   // Azul 50%
            wants: '#ec4899',   // Rosa 30%
            savings: '#10b981', // Verde 20%
          }
        }
      }
    }
  </script>
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Font Family Inter & Outfit -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Custom Styles & Animations -->
  <style>
    .glass-panel {
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .glass-card {
      background: rgba(30, 41, 59, 0.5);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .glow-effect {
      box-shadow: 0 0 25px -5px rgba(99, 102, 241, 0.25);
    }
    .animate-pulse-slow {
      animation: pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #090d16;
    }
    ::-webkit-scrollbar-thumb {
      background: #1e293b;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #334155;
    }
  </style>

  <div class="min-h-full font-sans antialiased flex flex-col justify-between selection:bg-brand-500 selection:text-white pb-12">

    <!-- Background Decorative Blur Elements -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-brand-600/20 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 -right-40 w-96 h-96 bg-pink-600/15 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 left-1/3 w-96 h-96 bg-emerald-600/15 rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 w-full">

      <!-- Header Section -->
      <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 pb-6 border-b border-slate-800">
        <div class="flex items-center gap-3">
          <div class="p-3 bg-gradient-to-br from-brand-500 to-purple-600 rounded-2xl shadow-lg shadow-brand-500/20 text-white">
            <i data-lucide="clock" class="w-8 h-8"></i>
          </div>
          <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold font-display tracking-tight text-white flex items-center gap-2">
              TimeWorth <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-brand-500/20 text-brand-500 border border-brand-500/30">Calculadora 50/30/20</span>
            </h1>
            <p class="text-slate-400 text-sm mt-0.5">Mide el costo real de tus compras en horas de trabajo y evalúa tu presupuesto</p>
          </div>
        </div>

        <!-- Preset Quick Currency Switch / Help -->
        <div class="flex items-center gap-3">
          <button id="btn-info-modal" class="flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-medium bg-slate-800/80 hover:bg-slate-700 text-slate-300 transition-colors border border-slate-700">
            <i data-lucide="help-circle" class="w-4 h-4 text-brand-500"></i>
            ¿Qué es la Regla 50/30/20?
          </button>
        </div>
      </header>

      <!-- Main Grid Content -->
      <main class="grid grid-cols-1 lg:grid-cols-12 gap-8">

        <!-- LEFT COLUMN: INPUT FORM (4 cols on lg) -->
        <section class="lg:col-span-5 space-y-6">
          <div class="glass-panel p-6 sm:p-7 rounded-3xl glow-effect space-y-6">
            <div class="flex items-center justify-between pb-4 border-b border-slate-800/80">
              <h2 class="text-lg font-bold font-display text-white flex items-center gap-2">
                <i data-lucide="sliders" class="w-5 h-5 text-brand-500"></i>
                Tus Datos Financieros
              </h2>
              <span class="text-xs text-slate-400">Paso 1 de 2</span>
            </div>

            <form id="calc-form" class="space-y-5" onsubmit="return false;">

              <!-- Salario Mensual -->
              <div>
                <label for="salary" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                  Salario Mensual Neto ($ MXN)
                </label>
                <div class="relative rounded-xl shadow-sm">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 font-bold">
                    $
                  </div>
                  <input type="number" id="salary" min="1" step="any" placeholder="9600" value="9600" required
                    class="w-full pl-9 pr-4 py-3 bg-slate-900/90 border border-slate-700/80 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-white placeholder-slate-500 font-semibold text-lg transition-all">
                </div>
                <p class="text-[11px] text-slate-400 mt-1">Ingresa lo que recibes libre de impuestos al mes.</p>
              </div>

              <!-- Horas trabajadas por semana -->
              <div>
                <div class="flex justify-between items-center mb-2">
                  <label for="hours-week" class="block text-xs font-semibold uppercase tracking-wider text-slate-300">
                    Horas trabajadas por semana
                  </label>
                  <span id="hours-val" class="text-xs font-bold text-brand-500 bg-brand-500/10 px-2 py-0.5 rounded">40 hrs</span>
                </div>
                <input type="range" id="hours-week" min="10" max="80" value="40" step="1"
                  class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-brand-500">
                <div class="flex justify-between text-[10px] text-slate-500 mt-1">
                  <span>10 hrs (Part-time)</span>
                  <span>40 hrs (Estándar)</span>
                  <span>80 hrs</span>
                </div>
              </div>

              <hr class="border-slate-800/80 my-4">

              <!-- Nombre de la compra -->
              <div>
                <label for="item-name" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                  ¿Qué deseas comprar?
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    <i data-lucide="shopping-bag" class="w-4 h-4"></i>
                  </div>
                  <input type="text" id="item-name" placeholder="Ej: iPhone 15, Tenis, Viaje..." value="Smartphone Gama Alta" required
                    class="w-full pl-10 pr-4 py-3 bg-slate-900/90 border border-slate-700/80 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-white placeholder-slate-500 text-sm transition-all">
                </div>
              </div>

              <!-- Categoría 50/30/20 -->
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                  Categoría del gasto (Regla 50/30/20)
                </label>
                <div class="grid grid-cols-3 gap-2">
                  <label class="cursor-pointer">
                    <input type="radio" name="category" value="needs" class="peer sr-only">
                    <div class="p-3 rounded-xl border border-slate-700/80 bg-slate-900/50 peer-checked:border-needs peer-checked:bg-needs/10 peer-checked:text-needs text-slate-400 text-center transition-all hover:bg-slate-800/60">
                      <i data-lucide="home" class="w-5 h-5 mx-auto mb-1"></i>
                      <span class="block text-xs font-bold">50% Necesidades</span>
                    </div>
                  </label>

                  <label class="cursor-pointer">
                    <input type="radio" name="category" value="wants" checked class="peer sr-only">
                    <div class="p-3 rounded-xl border border-slate-700/80 bg-slate-900/50 peer-checked:border-wants peer-checked:bg-wants/10 peer-checked:text-wants text-slate-400 text-center transition-all hover:bg-slate-800/60">
                      <i data-lucide="heart" class="w-5 h-5 mx-auto mb-1"></i>
                      <span class="block text-xs font-bold">30% Deseos</span>
                    </div>
                  </label>

                  <label class="cursor-pointer">
                    <input type="radio" name="category" value="savings" class="peer sr-only">
                    <div class="p-3 rounded-xl border border-slate-700/80 bg-slate-900/50 peer-checked:border-savings peer-checked:bg-savings/10 peer-checked:text-savings text-slate-400 text-center transition-all hover:bg-slate-800/60">
                      <i data-lucide="piggy-bank" class="w-5 h-5 mx-auto mb-1"></i>
                      <span class="block text-xs font-bold">20% Ahorro</span>
                    </div>
                  </label>
                </div>
              </div>

              <!-- Precio del Producto -->
              <div>
                <label for="item-cost" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                  Costo / Precio ($ MXN)
                </label>
                <div class="relative rounded-xl shadow-sm">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 font-bold">
                    $
                  </div>
                  <input type="number" id="item-cost" min="1" step="any" placeholder="100" value="100" required
                    class="w-full pl-9 pr-4 py-3 bg-slate-900/90 border border-slate-700/80 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-white placeholder-slate-500 font-semibold text-lg transition-all">
                </div>
              </div>

            </form>
          </div>

          <!-- Quick Summary Mini-Card -->
          <div class="glass-card p-5 rounded-2xl flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="p-2.5 rounded-xl bg-slate-800 text-slate-300">
                <i data-lucide="dollar-sign" class="w-5 h-5"></i>
              </div>
              <div>
                <p class="text-xs text-slate-400 font-medium">Tu valor hora estimado</p>
                <p id="hourly-rate-display" class="text-lg font-bold text-white">$0.00 / hr</p>
              </div>
            </div>
            <div class="text-right">
              <p class="text-xs text-slate-400 font-medium">Horas mes lab.</p>
              <p id="monthly-hours-display" class="text-sm font-semibold text-slate-200">173.3 hrs</p>
            </div>
          </div>
        </section>

        <!-- RIGHT COLUMN: RESULTS & DASHBOARD (7 cols on lg) -->
        <section class="lg:col-span-7 space-y-6">

          <!-- HERO DISPLAY: LIFE TIME COST CARD -->
          <div class="glass-panel p-6 sm:p-8 rounded-3xl relative overflow-hidden glow-effect border-brand-500/30">
            <!-- Background Subtle Gradient Accent -->
            <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-brand-500/10 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-extrabold uppercase tracking-widest text-brand-500 bg-brand-500/10 px-3 py-1 rounded-full border border-brand-500/20">
                Costo en Tiempo de Vida
              </span>
              <button id="btn-save" class="text-xs text-slate-400 hover:text-white flex items-center gap-1.5 bg-slate-800/80 hover:bg-slate-700 px-3 py-1.5 rounded-lg transition-colors border border-slate-700">
                <i data-lucide="bookmark" class="w-3.5 h-3.5"></i>
                Guardar
              </button>
            </div>

            <h3 id="res-item-title" class="text-2xl font-extrabold text-white mb-2 font-display">
              Smartphone Gama Alta
            </h3>
            <p class="text-slate-400 text-sm mb-6">Para pagar esta compra necesitas trabajar un equivalente de:</p>

            <!-- Highlight Big Stat -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
              <div class="bg-slate-900/80 p-4 rounded-2xl border border-slate-800 text-center">
                <span id="res-hours" class="block text-2xl sm:text-3xl font-extrabold text-brand-500 font-display">0</span>
                <span class="text-xs text-slate-400 font-medium">Horas</span>
              </div>
              <div class="bg-slate-900/80 p-4 rounded-2xl border border-slate-800 text-center">
                <span id="res-days" class="block text-2xl sm:text-3xl font-extrabold text-white font-display">0</span>
                <span class="text-xs text-slate-400 font-medium">Días Laborales</span>
              </div>
              <div class="bg-slate-900/80 p-4 rounded-2xl border border-slate-800 text-center">
                <span id="res-weeks" class="block text-2xl sm:text-3xl font-extrabold text-white font-display">0</span>
                <span class="text-xs text-slate-400 font-medium">Semanas</span>
              </div>
              <div class="bg-slate-900/80 p-4 rounded-2xl border border-slate-800 text-center">
                <span id="res-months" class="block text-2xl sm:text-3xl font-extrabold text-white font-display">0</span>
                <span class="text-xs text-slate-400 font-medium">Meses</span>
              </div>
            </div>

            <!-- Equivalencia en días de calendario real -->
            <div class="p-3.5 bg-slate-900/40 rounded-xl border border-slate-800/80 flex items-center gap-3 text-xs text-slate-300">
              <i data-lucide="calendar" class="w-4 h-4 text-brand-500 shrink-0"></i>
              <span id="res-calendar-desc">Equivale a dedicación exclusiva de trabajo continuo durante varias jornadas completas.</span>
            </div>
          </div>

          <!-- CATEGORY & IMPACT CARD (50/30/20 ANALYSIS) -->
          <div class="glass-panel p-6 sm:p-7 rounded-3xl space-y-6">
            <div class="flex items-center justify-between pb-4 border-b border-slate-800">
              <h3 class="text-lg font-bold font-display text-white flex items-center gap-2">
                <i data-lucide="pie-chart" class="w-5 h-5 text-brand-500"></i>
                Impacto en la Regla 50/30/20
              </h3>
              <span id="badge-impact" class="text-xs font-bold px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                Impacto Moderado
              </span>
            </div>

            <!-- Progress Bar & Gauge Category -->
            <div class="space-y-3">
              <div class="flex justify-between items-baseline text-sm">
                <span class="text-slate-300 font-medium flex items-center gap-2">
                  Consumo de la Categoría
                  <strong id="res-category-name" class="text-wants">Deseos (30%)</strong>:
                </span>
                <span id="res-category-percent" class="text-xl font-extrabold text-white font-display">0%</span>
              </div>

              <!-- Progress Bar -->
              <div class="w-full bg-slate-900 rounded-full h-4 p-0.5 border border-slate-800 relative overflow-hidden">
                <div id="res-progress-bar" class="bg-wants h-full rounded-full transition-all duration-1000 ease-out" style="width: 0%"></div>
              </div>

              <div class="flex justify-between text-[11px] text-slate-400 pt-1">
                <span>Gasto: <strong id="res-item-price-fmt" class="text-slate-200">$0</strong></span>
                <span>Presupuesto mensual categoría: <strong id="res-cat-budget-fmt" class="text-slate-200">$0</strong></span>
              </div>
            </div>

            <!-- Traffic Light Gauge Status Box -->
            <div id="status-box" class="p-4 rounded-2xl border bg-slate-900/60 border-slate-800 flex items-start gap-3 transition-colors">
              <div id="status-icon-container" class="p-2 rounded-xl bg-emerald-500/10 text-emerald-400 shrink-0 mt-0.5">
                <i data-lucide="check-circle-2" class="w-5 h-5"></i>
              </div>
              <div>
                <h4 id="status-title" class="font-bold text-sm text-white mb-1">Gasto Asequible</h4>
                <p id="status-desc" class="text-xs text-slate-300 leading-relaxed">
                  Este gasto encaja dentro de tu presupuesto asignado a esta categoría sin comprometer tus finanzas mensuales.
                </p>
              </div>
            </div>

            <!-- Breakdown Graphs & Budget Split -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">

              <!-- Chart Mini Container -->
              <div class="bg-slate-900/60 p-4 rounded-2xl border border-slate-800/80 flex flex-col items-center justify-center">
                <span class="text-xs font-semibold text-slate-400 mb-2 w-full text-left">Distribución de tu Salario</span>
                <div class="w-36 h-36 relative">
                  <canvas id="budgetChart"></canvas>
                </div>
              </div>

              <!-- Category Budget Breakdown Table -->
              <div class="bg-slate-900/60 p-4 rounded-2xl border border-slate-800/80 flex flex-col justify-between space-y-2">
                <span class="text-xs font-semibold text-slate-400">Tus Limites Mensuales (50/30/20)</span>

                <div class="space-y-2.5 text-xs">
                  <div class="flex justify-between items-center p-2 rounded-lg bg-slate-800/40 border-l-4 border-needs">
                    <span class="text-slate-300">Necesidades (50%)</span>
                    <span id="budget-needs-val" class="font-bold text-white">$0</span>
                  </div>
                  <div class="flex justify-between items-center p-2 rounded-lg bg-slate-800/40 border-l-4 border-wants">
                    <span class="text-slate-300">Deseos (30%)</span>
                    <span id="budget-wants-val" class="font-bold text-white">$0</span>
                  </div>
                  <div class="flex justify-between items-center p-2 rounded-lg bg-slate-800/40 border-l-4 border-savings">
                    <span class="text-slate-300">Ahorro/Inversión (20%)</span>
                    <span id="budget-savings-val" class="font-bold text-white">$0</span>
                  </div>
                </div>
              </div>

            </div>

          </div>

        </section>

      </main>

      <!-- SAVED HISTORY SECTION -->
      <section class="mt-12">
        <div class="glass-panel p-6 sm:p-8 rounded-3xl space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-800">
            <div>
              <h3 class="text-xl font-bold font-display text-white flex items-center gap-2">
                <i data-lucide="history" class="w-5 h-5 text-brand-500"></i>
                Historial de Compras Comparadas
              </h3>
              <p class="text-xs text-slate-400 mt-1">Guarda y compara diferentes ítems para tomar mejores decisiones</p>
            </div>
            <button id="btn-clear-history" class="text-xs text-rose-400 hover:text-rose-300 flex items-center gap-1.5 px-3 py-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 transition-colors border border-rose-500/20 self-start sm:self-auto">
              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
              Limpiar Historial
            </button>
          </div>

          <div id="history-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- Dynamically Populated -->
            <div class="col-span-full text-center py-8 text-slate-500 text-sm">
              <i data-lucide="ghost" class="w-8 h-8 mx-auto mb-2 opacity-50"></i>
              No has guardado ninguna compra en el historial aún.
            </div>
          </div>
        </div>
      </section>

    </div>

    <!-- FOOTER -->
    <footer class="mt-16 text-center text-xs text-slate-500 border-t border-slate-900 pt-8">
      <p>TimeWorth - Calculadora de Tiempo de Trabajo y Finanzas Personales. Basado en la regla de presupuesto 50/30/20.</p>
    </footer>

    <!-- MODAL: INFO REGLA 50/30/20 -->
    <div id="modal-info" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300">
      <div class="glass-panel max-w-lg w-full p-6 sm:p-7 rounded-3xl border-slate-700 shadow-2xl relative space-y-5">
        <button id="btn-close-modal" class="absolute top-5 right-5 text-slate-400 hover:text-white p-1 rounded-lg bg-slate-800">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>

        <div class="flex items-center gap-3">
          <div class="p-3 bg-brand-500/10 text-brand-500 rounded-2xl border border-brand-500/20">
            <i data-lucide="book-open" class="w-6 h-6"></i>
          </div>
          <h3 class="text-xl font-bold font-display text-white">¿Qué es la Regla 50/30/20?</h3>
        </div>

        <p class="text-xs text-slate-300 leading-relaxed">
          Es una fórmula popular de gestión financiera recomendada para dividir tus ingresos netos mensuales de forma saludable e inteligente:
        </p>

        <div class="space-y-3 text-xs">
          <div class="p-3 rounded-xl bg-slate-900/80 border-l-4 border-needs">
            <h4 class="font-bold text-needs text-sm mb-0.5">50% - Necesidades Básicas</h4>
            <p class="text-slate-400">Gastos indispensables para vivir: renta/hipoteca, servicios públicos, comida básica, transporte, seguros y salud.</p>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/80 border-l-4 border-wants">
            <h4 class="font-bold text-wants text-sm mb-0.5">30% - Deseos y Estilo de Vida</h4>
            <p class="text-slate-400">Gastos opcionales que mejoran tu calidad de vida: salidas, viajes, dispositivos, ropa no esencial, entretenimiento y hobbies.</p>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/80 border-l-4 border-savings">
            <h4 class="font-bold text-savings text-sm mb-0.5">20% - Ahorro e Inversión</h4>
            <p class="text-slate-400">Fondo de emergencia, pago de deudas, ahorro para retiro e inversiones para hacer crecer tu patrimonio.</p>
          </div>
        </div>

        <button id="btn-close-modal-2" class="w-full py-2.5 bg-slate-800 hover:bg-slate-700 font-bold text-xs text-white rounded-xl transition-colors">
          ¡Entendido!
        </button>
      </div>
    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
      // @ts-nocheck
      // State management
      let state = {
        salary: 9600, // Salario mensual neto inicial
        hoursPerWeek: 48,
        itemName: 'Starbucks',
        category: 'wants', // needs, wants, savings
        itemCost: 100,
        history: []
      };

      let chartInstance = null;

      // DOM Elements
      const salaryInput = document.getElementById('salary');
      const hoursWeekInput = document.getElementById('hours-week');
      const hoursValLabel = document.getElementById('hours-val');
      const itemNameInput = document.getElementById('item-name');
      const itemCostInput = document.getElementById('item-cost');
      const btnSave = document.getElementById('btn-save');
      const btnClearHistory = document.getElementById('btn-clear-history');

      // Display DOM Elements
      const hourlyRateDisplay = document.getElementById('hourly-rate-display');
      const monthlyHoursDisplay = document.getElementById('monthly-hours-display');
      const resItemTitle = document.getElementById('res-item-title');
      const resHours = document.getElementById('res-hours');
      const resDays = document.getElementById('res-days');
      const resWeeks = document.getElementById('res-weeks');
      const resMonths = document.getElementById('res-months');
      const resCalendarDesc = document.getElementById('res-calendar-desc');

      const resCategoryName = document.getElementById('res-category-name');
      const resCategoryPercent = document.getElementById('res-category-percent');
      const resProgressBar = document.getElementById('res-progress-bar');
      const resItemPriceFmt = document.getElementById('res-item-price-fmt');
      const resCatBudgetFmt = document.getElementById('res-cat-budget-fmt');

      const statusBox = document.getElementById('status-box');
      const statusIconContainer = document.getElementById('status-icon-container');
      const statusTitle = document.getElementById('status-title');
      const statusDesc = document.getElementById('status-desc');
      const badgeImpact = document.getElementById('badge-impact');

      const budgetNeedsVal = document.getElementById('budget-needs-val');
      const budgetWantsVal = document.getElementById('budget-wants-val');
      const budgetSavingsVal = document.getElementById('budget-savings-val');

      const historyContainer = document.getElementById('history-container');

      // Modal Elements
      const modalInfo = document.getElementById('modal-info');
      const btnInfoModal = document.getElementById('btn-info-modal');
      const btnCloseModal = document.getElementById('btn-close-modal');
      const btnCloseModal2 = document.getElementById('btn-close-modal-2');

      // Initialize
      window.addEventListener('DOMContentLoaded', () => {
        // Set initial values in input fields
        salaryInput.value = state.salary;
        hoursWeekInput.value = state.hoursPerWeek;
        hoursValLabel.textContent = `${state.hoursPerWeek} hrs`;
        itemNameInput.value = state.itemName;
        itemCostInput.value = state.itemCost;

        if (window.lucide) {
          lucide.createIcons();
        }
        loadHistory();
        initChart();
        calculateAndRender();

        // Setup Event Listeners
        hoursWeekInput.addEventListener('input', (e) => {
          hoursValLabel.textContent = `${e.target.value} hrs`;
          calculateAndRender();
        });

        salaryInput.addEventListener('input', calculateAndRender);
        itemCostInput.addEventListener('input', calculateAndRender);
        itemNameInput.addEventListener('input', calculateAndRender);

        document.querySelectorAll('input[name="category"]').forEach(radio => {
          radio.addEventListener('change', calculateAndRender);
        });

        btnSave.addEventListener('click', saveToHistory);
        btnClearHistory.addEventListener('click', clearHistory);

        // Modal Events
        btnInfoModal.addEventListener('click', openModal);
        btnCloseModal.addEventListener('click', closeModal);
        btnCloseModal2.addEventListener('click', closeModal);
      });

      // Formatting helpers
      const formatMoney = (amount) => {
        return new Intl.NumberFormat('es-MX', {
          style: 'currency',
          currency: 'MXN',
          maximumFractionDigits: 0
        }).format(amount);
      };

      const formatDecimal = (num) => {
        return new Intl.NumberFormat('es-MX', {
          maximumFractionDigits: 1
        }).format(num);
      };

      // Main calculation & render function
      function calculateAndRender() {
        // Read values
        const salary = parseFloat(salaryInput.value) || 0;
        const hoursPerWeek = parseFloat(hoursWeekInput.value) || 48;
        const itemName = itemNameInput.value.trim() || 'Artículo';
        const itemCost = parseFloat(itemCostInput.value) || 0;
        const categoryRadio = document.querySelector('input[name="category"]:checked');
        const category = categoryRadio ? categoryRadio.value : 'wants';

        state = { salary, hoursPerWeek, itemName, category, itemCost, history: state.history };

        // Working hours calculations
        // Average weeks in a month: 52 weeks / 12 months = 4.333
        const monthlyHours = hoursPerWeek * (52 / 12);
        const hourlyRate = salary > 0 ? salary / monthlyHours : 0;

        // Update hourly rate badges
        hourlyRateDisplay.textContent = `${formatMoney(hourlyRate)} / hr`;
        monthlyHoursDisplay.textContent = `${formatDecimal(monthlyHours)} hrs`;

        // Time required for item
        const hoursRequired = hourlyRate > 0 ? itemCost / hourlyRate : 0;
        const daysRequired = hoursPerWeek > 0 ? (hoursRequired / (hoursPerWeek / 5)) : 0; // 5 working days a week
        const weeksRequired = hoursPerWeek > 0 ? hoursRequired / hoursPerWeek : 0;
        const monthsRequired = monthlyHours > 0 ? hoursRequired / monthlyHours : 0;

        // Render Hero Time Stats
        resItemTitle.textContent = itemName;
        animateValue(resHours, parseFloat(resHours.textContent) || 0, hoursRequired, 0);
        animateValue(resDays, parseFloat(resDays.textContent) || 0, daysRequired, 1);
        animateValue(resWeeks, parseFloat(resWeeks.textContent) || 0, weeksRequired, 1);
        animateValue(resMonths, parseFloat(resMonths.textContent) || 0, monthsRequired, 1);

        // Calendar description explanation
        if (hoursRequired === 0) {
          resCalendarDesc.textContent = 'Ingresa un costo válido para ver el desglose.';
        } else if (hoursRequired <= 8) {
          resCalendarDesc.textContent = `Este gasto requiere menos de un día laboral completo (${formatDecimal(hoursRequired)} horas efectivas de tu trabajo).`;
        } else if (daysRequired <= 5) {
          resCalendarDesc.textContent = `Equivale a trabajar aproximadamente ${formatDecimal(daysRequired)} días hábiles de esta semana exclusivamente para este objeto.`;
        } else if (weeksRequired <= 4) {
          resCalendarDesc.textContent = `Tendrás que trabajar cerca de ${formatDecimal(weeksRequired)} semanas completas solo para financiar este gasto.`;
        } else {
          resCalendarDesc.textContent = `Representa más de ${formatDecimal(monthsRequired)} meses enteros de todo tu esfuerzo y jornada laboral.`;
        }

        // Budget 50/30/20 Breakdown
        const budgetNeeds = salary * 0.50;
        const budgetWants = salary * 0.30;
        const budgetSavings = salary * 0.20;

        budgetNeedsVal.textContent = formatMoney(budgetNeeds);
        budgetWantsVal.textContent = formatMoney(budgetWants);
        budgetSavingsVal.textContent = formatMoney(budgetSavings);

        // Category analysis
        let catBudget = budgetWants;
        let catNameText = 'Deseos (30%)';
        let catColorClass = 'text-wants';
        let catBgColorClass = 'bg-wants';

        if (category === 'needs') {
          catBudget = budgetNeeds;
          catNameText = 'Necesidades (50%)';
          catColorClass = 'text-needs';
          catBgColorClass = 'bg-needs';
        } else if (category === 'savings') {
          catBudget = budgetSavings;
          catNameText = 'Ahorro / Inversión (20%)';
          catColorClass = 'text-savings';
          catBgColorClass = 'bg-savings';
        }

        const percentOfCategory = catBudget > 0 ? (itemCost / catBudget) * 100 : 0;

        // Update Category Displays
        resCategoryName.textContent = catNameText;
        resCategoryName.className = `font-bold ${catColorClass}`;
        resCategoryPercent.textContent = `${formatDecimal(percentOfCategory)}%`;
        resItemPriceFmt.textContent = formatMoney(itemCost);
        resCatBudgetFmt.textContent = formatMoney(catBudget);

        // Update progress bar width & color
        resProgressBar.className = `h-full rounded-full transition-all duration-1000 ease-out ${catBgColorClass}`;
        // Cap visual progress bar at 100% for display smoothness, but show exact % text
        resProgressBar.style.width = `${Math.min(percentOfCategory, 100)}%`;

        // Status Traffic Light Evaluation
        evaluateImpactStatus(percentOfCategory);

        // Update Donut Chart
        updateChart(budgetNeeds, budgetWants, budgetSavings);
      }

      // Impact Status Evaluation (Semaphore logic)
      function evaluateImpactStatus(percent) {
        if (percent === 0) {
          statusBox.className = "p-4 rounded-2xl border bg-slate-900/60 border-slate-800 flex items-start gap-3 transition-colors";
          statusIconContainer.className = "p-2 rounded-xl bg-slate-800 text-slate-400 shrink-0 mt-0.5";
          statusIconContainer.innerHTML = `<i data-lucide="info" class="w-5 h-5"></i>`;
          statusTitle.textContent = "Ingresa los datos";
          statusDesc.textContent = "Agrega el costo para evaluar el impacto en tu presupuesto.";
          badgeImpact.textContent = "Sin datos";
          badgeImpact.className = "text-xs font-bold px-3 py-1 rounded-full bg-slate-800 text-slate-400 border border-slate-700";
        } else if (percent <= 25) {
          // Green / Low
          statusBox.className = "p-4 rounded-2xl border bg-emerald-950/30 border-emerald-500/30 flex items-start gap-3 transition-colors";
          statusIconContainer.className = "p-2 rounded-xl bg-emerald-500/20 text-emerald-400 shrink-0 mt-0.5";
          statusIconContainer.innerHTML = `<i data-lucide="check-circle-2" class="w-5 h-5"></i>`;
          statusTitle.textContent = "Gasto Ligero y Manejable";
          statusTitle.className = "font-bold text-sm text-emerald-300 mb-0.5";
          statusDesc.textContent = "Este gasto consume una porción pequeña de la categoría asignada. Excelente oportunidad si está planificado.";
          badgeImpact.textContent = "Impacto Bajo";
          badgeImpact.className = "text-xs font-bold px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20";
        } else if (percent <= 75) {
          // Yellow / Moderate
          statusBox.className = "p-4 rounded-2xl border bg-amber-950/30 border-amber-500/30 flex items-start gap-3 transition-colors";
          statusIconContainer.className = "p-2 rounded-xl bg-amber-500/20 text-amber-400 shrink-0 mt-0.5";
          statusIconContainer.innerHTML = `<i data-lucide="alert-triangle" class="w-5 h-5"></i>`;
          statusTitle.textContent = "Impacto Moderado";
          statusTitle.className = "font-bold text-sm text-amber-300 mb-0.5";
          statusDesc.textContent = "Consume una parte considerable de tu margen mensual para esta categoría. Asegúrate de moderar otros gastos similares este mes.";
          badgeImpact.textContent = "Impacto Moderado";
          badgeImpact.className = "text-xs font-bold px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20";
        } else {
          // Red / High
          statusBox.className = "p-4 rounded-2xl border bg-rose-950/30 border-rose-500/30 flex items-start gap-3 transition-colors";
          statusIconContainer.className = "p-2 rounded-xl bg-rose-500/20 text-rose-400 shrink-0 mt-0.5";
          statusIconContainer.innerHTML = `<i data-lucide="alert-octagon" class="w-5 h-5"></i>`;
          statusTitle.textContent = "Gasto Elevado / Excede Margen";
          statusTitle.className = "font-bold text-sm text-rose-300 mb-0.5";
          statusDesc.textContent = "¡Atención! Este gasto representa más del 75% (o supera el 100%) de tu presupuesto disponible para esta categoría este mes.";
          badgeImpact.textContent = "Impacto Alto";
          badgeImpact.className = "text-xs font-bold px-3 py-1 rounded-full bg-rose-500/10 text-rose-400 border border-rose-500/20";
        }
        if (window.lucide) {
          lucide.createIcons();
        }
      }

      // Smooth Number Animation helper
      function animateValue(element, start, end, decimals = 1, duration = 600) {
        if (isNaN(end)) end = 0;
        let startTimestamp = null;
        const step = (timestamp) => {
          if (!startTimestamp) startTimestamp = timestamp;
          const progress = Math.min((timestamp - startTimestamp) / duration, 1);
          const currentVal = progress * (end - start) + start;
          element.textContent = formatDecimal(currentVal);
          if (progress < 1) {
            window.requestAnimationFrame(step);
          } else {
            element.textContent = formatDecimal(end);
          }
        };
        window.requestAnimationFrame(step);
      }

      // Donut Chart Initialization
      function initChart() {
        const ctx = document.getElementById('budgetChart').getContext('2d');
        chartInstance = new Chart(ctx, {
          type: 'doughnut',
          data: {
            labels: ['Necesidades (50%)', 'Deseos (30%)', 'Ahorro (20%)'],
            datasets: [{
              data: [50, 30, 20],
              backgroundColor: ['#3b82f6', '#ec4899', '#10b981'],
              borderWidth: 0,
              hoverOffset: 4
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    return ` ${context.label}: ${formatMoney(context.raw)}`;
                  }
                }
              }
            },
            cutout: '72%'
          }
        });
      }

      function updateChart(needs, wants, savings) {
        if (!chartInstance) return;
        chartInstance.data.datasets[0].data = [needs, wants, savings];
        chartInstance.update();
      }

      // Local Storage - History
      function saveToHistory() {
        if (!state.itemName || state.itemCost <= 0) return;

        const monthlyHours = state.hoursPerWeek * (52 / 12);
        const hourlyRate = state.salary / monthlyHours;
        const hoursRequired = hourlyRate > 0 ? state.itemCost / hourlyRate : 0;

        // Presupuesto de la categoría actual
        let catBudget = state.salary * 0.30; // default 'wants'
        if (state.category === 'needs') catBudget = state.salary * 0.50;
        if (state.category === 'savings') catBudget = state.salary * 0.20;

        const percentOfCategory = catBudget > 0 ? (state.itemCost / catBudget) * 100 : 0;

        const newItem = {
          id: Date.now(),
          name: state.itemName,
          cost: state.itemCost,
          category: state.category,
          hours: hoursRequired,
          percent: percentOfCategory,
          date: new Date().toLocaleDateString('es-MX', { month: 'short', day: 'numeric' })
        };

        state.history.unshift(newItem);
        if (state.history.length > 9) state.history.pop(); // Keep top 9

        localStorage.setItem('timeworth_history', JSON.stringify(state.history));
        renderHistory();

        // Feedback animation
        btnSave.classList.add('bg-brand-600', 'text-white');
        btnSave.innerHTML = `<i data-lucide="check" class="w-3.5 h-3.5"></i> ¡Guardado!`;
        setTimeout(() => {
          btnSave.classList.remove('bg-brand-600', 'text-white');
          btnSave.innerHTML = `<i data-lucide="bookmark" class="w-3.5 h-3.5"></i> Guardar`;
          if (window.lucide) {
            lucide.createIcons();
          }
        }, 1500);
      }

      function loadHistory() {
        const saved = localStorage.getItem('timeworth_history');
        if (saved) {
          try {
            state.history = JSON.parse(saved);
          } catch (e) {
            state.history = [];
          }
        }
        renderHistory();
      }

      function clearHistory() {
        state.history = [];
        localStorage.removeItem('timeworth_history');
        renderHistory();
      }

      function renderHistory() {
        if (state.history.length === 0) {
          historyContainer.innerHTML = `
            <div class="col-span-full text-center py-8 text-slate-500 text-sm">
              <i data-lucide="ghost" class="w-8 h-8 mx-auto mb-2 opacity-50"></i>
              No has guardado ninguna compra en el historial aún.
            </div>
          `;
          if (window.lucide) {
            lucide.createIcons();
          }
          return;
        }

        historyContainer.innerHTML = state.history.map(item => {
          let catBadgeColor = 'bg-wants/10 text-wants border-wants/20';
          let catLabel = 'Deseos';
          if (item.category === 'needs') {
            catBadgeColor = 'bg-needs/10 text-needs border-needs/20';
            catLabel = 'Necesidades';
          } else if (item.category === 'savings') {
            catBadgeColor = 'bg-savings/10 text-savings border-savings/20';
            catLabel = 'Ahorro';
          }

          const percentText = item.percent !== undefined ? `${formatDecimal(item.percent)}%` : 'N/A';

          return `
            <div class="glass-card p-4 rounded-2xl space-y-3 relative group hover:border-slate-700 transition-all">
              <div class="flex justify-between items-start gap-2">
                <div>
                  <h4 class="font-bold text-white text-sm line-clamp-1">${item.name}</h4>
                  <span class="text-[10px] text-slate-400">${item.date}</span>
                </div>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full border ${catBadgeColor}">
                  ${catLabel}
                </span>
              </div>

              <div class="grid grid-cols-3 gap-2 pt-1 border-t border-slate-800/60 text-center">
                <div>
                  <span class="text-[10px] text-slate-400 block">Costo</span>
                  <span class="font-bold text-slate-200 text-xs sm:text-sm">${formatMoney(item.cost)}</span>
                </div>
                <div>
                  <span class="text-[10px] text-slate-400 block">% Categoría</span>
                  <span class="font-bold text-slate-200 text-xs sm:text-sm">${percentText}</span>
                </div>
                <div>
                  <span class="text-[10px] text-slate-400 block">Tiempo Vida</span>
                  <span class="font-extrabold text-brand-400 font-display text-xs sm:text-sm">${formatDecimal(item.hours)} hrs</span>
                </div>
              </div>
            </div>
          `;
        }).join('');

        if (window.lucide) {
          lucide.createIcons();
        }
      }

      // Modal Control Functions
      function openModal() {
        modalInfo.classList.remove('hidden');
        setTimeout(() => {
          modalInfo.classList.remove('opacity-0');
        }, 10);
      }

      function closeModal() {
        modalInfo.classList.add('opacity-0');
        setTimeout(() => {
          modalInfo.classList.add('hidden');
        }, 300);
      }
    </script>
  </div>

</BaseLayout>
