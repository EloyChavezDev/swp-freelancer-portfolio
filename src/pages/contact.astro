---
import PageLayout from '~/layouts/PageLayout.astro';
import ContactForm from '~/components/ContactForm.astro';
import Icon from '~/components/Icon.astro';
import Faq from '~/components/home/Faq.astro';
import siteConfig from '~/config/site';
import { graph, personSchema, breadcrumbSchema } from '~/lib/jsonld';

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: 'Inicio', url: `${siteConfig.url}/` },
    { name: 'Contacto', url: `${siteConfig.url}/contact/` },
  ]),
]);
---

<PageLayout
  title="Contacto"
  heading="Pongamos en orden tus finanzas."
  eyebrow="Contacto"
  intro="Cuéntame tus metas, desafíos o situación financiera. Te ayudo a crear un plan claro y práctico para alcanzar tus objetivos."
  description={`Contacto con ${siteConfig.author} para asesorías financieras personales, talleres, conferencias y asesorías para empresas.`}
  crumbs={[{ label: 'Contacto' }]}
  jsonLd={jsonLd}
>
  <section class="wrap sec" style="padding-top:0" aria-labelledby="form-h">
    <div class="contact-grid">
      <div class="rev">
        <h2 class="d3" id="form-h" style="margin-bottom:24px">Solicita tu asesoría</h2>
        <ContactForm />
      </div>

      <div class="contact-aside rev rev-d1">
        <a class="contact-card" href={`mailto:${siteConfig.contact.email}`}>
          <i><Icon name="mail" /></i>
          <div>
            <b>Correo</b>
            <span>{siteConfig.contact.email}</span>
          </div>
        </a>
        <a class="contact-card" href={`tel:${siteConfig.contact.phoneHref}`}>
          <i><Icon name="phone" /></i>
          <div>
            <b>Teléfono</b>
            <span>{siteConfig.contact.phone}</span>
          </div>
        </a>
        <div class="contact-card">
          <i><Icon name="pin" /></i>
          <div>
            <b>Modalidad</b>
            <span>{siteConfig.contact.location}</span>
          </div>
        </div>
        <div class="contact-card">
          <i><Icon name="spark" /></i>
          <div>
            <b>Disponibilidad</b>
            <span>{siteConfig.contact.availability}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Faq />
</PageLayout>
