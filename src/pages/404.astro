---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/Button.astro';
---

<BaseLayout title="Página no encontrada" description="Página no encontrada" noindex>
  <section class="wrap nf">
    <p class="nf-code" aria-hidden="true">404</p>
    <h1 class="d2">Página no encontrada</h1>
    <p>
      La página que buscas no existe o ha sido movida.
    </p>
    <div class="nf-actions">
      <Button href="/" variant="lime">Volver al inicio</Button>
      <Button href="/services/" variant="outline">Ver servicios</Button>
    </div>
  </section>
</BaseLayout>
