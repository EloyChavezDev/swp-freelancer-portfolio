---
import Button from './Button.astro';
import siteConfig from '~/config/site';

const endpoint = siteConfig.contact.formEndpoint.trim();
const connected = endpoint.length > 0;
---

<form
  class="form"
  method="post"
  action={connected ? endpoint : undefined}
  name="contact"
  novalidate={false}
>
  <!-- Netlify Forms picks the form up from this attribute at build time. -->
  <input type="hidden" name="form-name" value="contact" />

  <div class="form-row">
    <div class="field">
      <label for="cf-name">Nombre</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required placeholder="Tu nombre" />
    </div>
    <div class="field">
      <label for="cf-email">Correo electrónico</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required placeholder="tu@correo.com" />
    </div>
  </div>

  <div class="field">
    <label for="cf-company">Empresa <span class="hint">(opcional)</span></label>
    <input id="cf-company" name="company" type="text" autocomplete="organization" />
  </div>

  <div class="field">
    <label for="cf-type">¿De qué se trata?</label>
    <select id="cf-type" name="project_type">
      <option value="talleres-online">Talleres Online</option>
      <option value="asesorias-personalizadas" selected>Asesorías Personalizadas</option>
      <option value="conferencias">Conferencias</option>
      <option value="asesorias-empresas">Asesorías para Empresas</option>
      <option value="algo-mas">Algo más</option>
    </select>
  </div>

  <div class="field">
    <label for="cf-message">Mensaje</label>
    <p class="hint" id="cf-message-hint">
      Cuéntame tus metas, desafíos financieros o lo que necesitas.
    </p>
    <textarea
      id="cf-message"
      name="message"
      rows="7"
      required
      aria-describedby="cf-message-hint"
      placeholder="Escríbeme tu consulta aquí."></textarea>
  </div>

  <!-- Honeypot: hidden from people, irresistible to bots. -->
  <div class="hp" aria-hidden="true">
    <label for="cf-website">Dejar este campo vacío</label>
    <input id="cf-website" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
  </div>

  {
    !connected && (
      <p class="form-note">
        <strong>Este formulario aún no está conectado.</strong> Agrega el endpoint de tu proveedor
        de formularios a <code>contact.formEndpoint</code> en <code>src/config/site.ts</code> para que
        comience a recibir mensajes.
      </p>
    )
  }

  <div>
    <Button type="submit" variant="ink" icon="mail" disabled={!connected}>Enviar solicitud</Button>
  </div>
</form>
