---
import Icon from './Icon.astro';
import Button from './Button.astro';
import siteConfig from '~/config/site';
import { primaryNav, mobileExtraNav } from '~/data/navigation';

const path = Astro.url.pathname;
const isHome = path === '/' || path === '';

/** Exact match gets `aria-current="page"`; an ancestor section is only styled. */
function state(href: string) {
  if (href === '/') return isHome ? 'page' : null;
  if (path === href) return 'page';
  return path.startsWith(href) ? 'section' : null;
}

/** On the homepage, nav items with an anchor scroll instead of navigating. */
function target(href: string, anchor?: string) {
  return isHome && anchor ? anchor : href;
}
---

<header class="hdr" id="top">
  <div class="wrap hdr-in">
    <a class="brand" href="/">
      <img
        src={siteConfig.logo.header.src}
        alt={`${siteConfig.name} — home`}
        width={siteConfig.logo.header.width}
        height={siteConfig.logo.header.height}
        fetchpriority="high"
        decoding="async"
      />
    </a>

    <nav class="nav" aria-label="Primary">
      {
        primaryNav.map((item) => {
          const s = state(item.href);
          const hasChildren = item.children && item.children.length > 0;
          return (
            <div class={['nav-item', hasChildren && 'has-children'].filter(Boolean).join(' ')}>
              <a
                href={target(item.href, item.anchor)}
                aria-current={s === 'page' ? 'page' : undefined}
                class={s === 'section' ? 'is-section' : undefined}
                aria-haspopup={hasChildren ? 'true' : undefined}
                aria-expanded={hasChildren ? 'false' : undefined}
              >
                {item.label}
                {hasChildren && <Icon name="arrow" class="ic-xs nav-arrow" />}
              </a>
              {hasChildren && (
                <div class="nav-dropdown" aria-hidden="true">
                  <div class="nav-dropdown-inner">
                    {item.children.map((child) => {
                      const cs = state(child.href);
                      return (
                        <a
                          href={child.href}
                          target={child.target}
                          aria-current={cs === 'page' ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      );
                    })}
                  </div>
                </div>
              )}
            </div>
          );
        })
      }
    </nav>

    <Button href="/work/" variant="ink" class="hdr-cta">See the work</Button>

    <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mnav">
      <Icon name="menu" />
    </button>
  </div>

  <div class="mnav" id="mnav">
    <nav aria-label="Mobile">
      {
        [...primaryNav, ...mobileExtraNav].map((item) => {
          const s = state(item.href);
          return (
            <a href={item.href} aria-current={s === 'page' ? 'page' : undefined}>
              {item.label}
            </a>
          );
        })
      }
    </nav>
    <Button href="/contact/" variant="ink">Send the brief</Button>
  </div>
</header>

<script>
  const burger = document.getElementById('burger');
  const panel = document.getElementById('mnav');

  if (burger && panel) {
    const OPEN_LABEL = 'Open menu';
    const CLOSE_LABEL = 'Close menu';

    const setIcon = (open: boolean) => {
      const use = burger.querySelector('use');
      if (use) use.setAttribute('href', open ? '#i-close' : '#i-menu');
    };

    const setOpen = (open: boolean) => {
      panel.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      burger.setAttribute('aria-label', open ? CLOSE_LABEL : OPEN_LABEL);
      setIcon(open);
    };

    burger.addEventListener('click', () => {
      const open = !panel.classList.contains('open');
      setOpen(open);
      if (open) panel.querySelector<HTMLAnchorElement>('a')?.focus();
    });

    // Close after a link is chosen.
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    // Escape closes and returns focus to the trigger.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('open')) {
        setOpen(false);
        burger.focus();
      }
    });

    // Never leave the drawer open when it is no longer reachable.
    const wide = window.matchMedia('(min-width: 1001px)');
    wide.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }

  // Desktop dropdown toggle (hover + keyboard support)
  const navItems = document.querySelectorAll<HTMLElement>('.nav-item.has-children');
  navItems.forEach((item) => {
    const link = item.querySelector<HTMLElement>('.nav-item > a');
    const dropdown = item.querySelector<HTMLElement>('.nav-dropdown');

    if (!link || !dropdown) return;

    let hideTimer: number | null = null;

    const show = () => {
      if (hideTimer) clearTimeout(hideTimer);
      dropdown.classList.add('open');
      link.setAttribute('aria-expanded', 'true');
    };

    const hide = () => {
      hideTimer = setTimeout(() => {
        dropdown.classList.remove('open');
        link.setAttribute('aria-expanded', 'false');
      }, 150);
    };

    item.addEventListener('mouseenter', show);
    item.addEventListener('mouseleave', hide);

    // Keyboard: Enter/Space toggles; Escape closes
    link.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (dropdown.classList.contains('open')) {
          hide();
        } else {
          show();
        }
      } else if (e.key === 'Escape') {
        hide();
      }
    });

    // Keep dropdown open while interacting with it
    dropdown.addEventListener('mouseenter', show);
    dropdown.addEventListener('mouseleave', hide);
  });
</script>